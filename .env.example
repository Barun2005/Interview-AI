# Environment Configuration Example
# Copy this file to .env and fill in your actual values

PORT=5000
VITE_API_BASE_URL=http://localhost:5000/api
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/interview_ai?retryWrites=true&w=majority

# Optional Email SMTP Settings (For delivering real OTP emails to inboxes)
# If using Gmail: Use smtp.gmail.com with an App Password (16-character code from Google Account Security)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL="Interview AI" <no-reply@interviewai.com>
